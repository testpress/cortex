require "json"

default_platform(:android)

def root_dir
  File.expand_path("..", File.dirname(__FILE__))
end

def resolve_path(path)
  return nil if path.nil? || path.to_s.empty?
  expanded = File.expand_path(path)
  return expanded if File.exist?(expanded)
  from_root = File.expand_path(path, root_dir)
  return from_root if File.exist?(from_root)
  from_root
end

def release_metadata
  candidates = [
    File.expand_path("release_metadata.json", Dir.pwd),
    File.expand_path("../release_metadata.json", Dir.pwd),
    File.expand_path("release_metadata.json", File.dirname(__FILE__)),
    File.expand_path("../release_metadata.json", File.dirname(__FILE__))
  ]
  meta_file = candidates.find { |f| File.exist?(f) }
  return JSON.parse(File.read(meta_file)) if meta_file
  {}
end

platform :android do
  desc "Deploy Android App Bundle to Google Play Store"
  lane :deploy do |options|
    meta = release_metadata
    package_name = options[:package_name] || meta["package_name"]
    default_aab = resolve_path("app/build/app/outputs/bundle/release/app-release.aab")
    aab_path = options[:aab] ? resolve_path(options[:aab]) : (File.exist?(default_aab) ? default_aab : Dir[File.join(root_dir, "app/build/app/outputs/bundle/release/*.aab")].sort.first)
    json_key = resolve_path(options[:json_key] || meta["play_key_path"] || "app/android/play_console_key.json")
    track = options[:track] || "production"

    UI.user_error!("Missing package_name in options or release_metadata.json") unless package_name && !package_name.empty?
    UI.user_error!("AAB file not found at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Play Console key file not found at #{json_key}") unless File.exist?(json_key)

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: aab_path,
      json_key: json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end

platform :ios do
  desc "Build and deploy iOS app to TestFlight"
  lane :deploy do |options|
    meta = release_metadata
    bundle_id  = options[:bundle_id]  || meta["bundle_id"]
    key_id     = options[:key_id]     || meta["apple_key_id"]
    issuer_id  = options[:issuer_id]  || meta["apple_issuer_id"]
    key_filepath = resolve_path(options[:key_filepath] || meta["apple_key_path"])

    app_version  = options[:app_version]  || ENV["APP_VERSION"]
    build_number = options[:build_number] || ENV["BUILD_NUMBER"]

    UI.user_error!("Missing bundle_id")       unless bundle_id   && !bundle_id.empty?
    UI.user_error!("Missing apple_key_id")    unless key_id      && !key_id.empty?
    UI.user_error!("Missing apple_issuer_id") unless issuer_id   && !issuer_id.empty?
    UI.user_error!("Key file not found at #{key_filepath}") unless key_filepath && File.exist?(key_filepath)
    UI.user_error!("Missing APP_VERSION")     unless app_version  && !app_version.to_s.empty?
    UI.user_error!("Missing BUILD_NUMBER")    unless build_number && !build_number.to_s.empty?

    api_key = app_store_connect_api_key(
      key_id:       key_id,
      issuer_id:    issuer_id,
      key_filepath: key_filepath
    )

    # Download (or regenerate) the App Store provisioning profile.
    # Installs it to ~/Library/MobileDevice/Provisioning Profiles/.
    get_provisioning_profile(
      app_identifier: bundle_id,
      api_key:        api_key,
      force:          true
    )
    profile_udid = lane_context[SharedValues::SIGH_UDID]
    UI.message("✅ Profile ready — UDID: #{profile_udid}")

    app_dir = File.join(root_dir, "app")

    # Phase 1 — Flutter compilation + xcarchive (no code-signing yet).
    # --no-codesign skips the xcodebuild -exportArchive step so gym can
    # do it below with the correct manual signing, identical to the reference repo.
    Bundler.with_unbundled_env do
      sh("cd '#{app_dir}' && flutter build ipa --release --no-codesign " \
         "--build-name='#{app_version}' --build-number='#{build_number}' " \
         "--dart-define-from-file=dart_defines.json")
    end

    archive_path = Dir.glob(File.join(app_dir, "build/ios/archive/*.xcarchive")).first
    UI.user_error!("xcarchive not found after flutter build") unless archive_path

    # Phase 2 — Export the xcarchive with manual signing.
    # This is exactly what the reference repo does inside build_app's export_options.
    build_app(
      skip_build_archive: true,
      archive_path:       archive_path,
      export_method:      "app-store",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          bundle_id => profile_udid
        }
      }
    )

    ipa_path = lane_context[SharedValues::IPA_OUTPUT_PATH]
    UI.user_error!("IPA not found after build_app") unless ipa_path && File.exist?(ipa_path)

    upload_to_testflight(
      api_key:                           api_key,
      ipa:                               ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external:               false,
      notify_external_testers:           false
    )
  end
end

