require "json"

default_platform(:android)

def root_dir
  File.expand_path("..", File.dirname(__FILE__))
end

def resolve_path(path)
  return nil if path.nil? || path.to_s.empty?
  expanded = File.expand_path(path)
  return expanded if File.exist?(expanded)
  from_root = File.expand_path(path, root_dir)
  return from_root if File.exist?(from_root)
  from_root
end

def release_metadata
  candidates = [
    File.expand_path("release_metadata.json", Dir.pwd),
    File.expand_path("../release_metadata.json", Dir.pwd),
    File.expand_path("release_metadata.json", File.dirname(__FILE__)),
    File.expand_path("../release_metadata.json", File.dirname(__FILE__))
  ]
  meta_file = candidates.find { |f| File.exist?(f) }
  return JSON.parse(File.read(meta_file)) if meta_file
  {}
end

platform :android do
  desc "Deploy Android App Bundle to Google Play Store"
  lane :deploy do |options|
    meta = release_metadata
    package_name = options[:package_name] || meta["package_name"]
    aab_path = options[:aab] ? resolve_path(options[:aab]) : (Dir[File.join(root_dir, "app/build/app/outputs/bundle/release/*.aab")].first || resolve_path("app/build/app/outputs/bundle/release/app-release.aab"))
    json_key = resolve_path(options[:json_key] || meta["play_key_path"] || "app/android/play_console_key.json")
    track = options[:track] || "production"

    UI.user_error!("Missing package_name in options or release_metadata.json") unless package_name && !package_name.empty?
    UI.user_error!("AAB file not found at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Play Console key file not found at #{json_key}") unless File.exist?(json_key)

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: aab_path,
      json_key: json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end

platform :ios do
  desc "Fetch provisioning profile using App Store Connect API Key"
  lane :get_profile do |options|
    meta = release_metadata
    bundle_id = options[:bundle_id] || meta["bundle_id"]
    key_id = options[:key_id] || meta["apple_key_id"]
    issuer_id = options[:issuer_id] || meta["apple_issuer_id"]
    key_filepath = resolve_path(options[:key_filepath] || meta["apple_key_path"])

    UI.user_error!("Missing bundle_id in options or release_metadata.json") unless bundle_id && !bundle_id.empty?
    UI.user_error!("Missing apple_key_id in options or release_metadata.json") unless key_id && !key_id.empty?
    UI.user_error!("Missing apple_issuer_id in options or release_metadata.json") unless issuer_id && !issuer_id.empty?
    UI.user_error!("Key file not found at #{key_filepath}") unless key_filepath && File.exist?(key_filepath)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )

    get_provisioning_profile(
      app_identifier: bundle_id,
      api_key: api_key,
      readonly: true,
      skip_certificate_verification: true
    )
  end

  desc "Deploy iOS IPA to TestFlight"
  lane :deploy do |options|
    meta = release_metadata
    ipa_path = options[:ipa] ? resolve_path(options[:ipa]) : Dir[File.join(root_dir, "app/build/ios/ipa/*.ipa")].first
    key_id = options[:key_id] || meta["apple_key_id"]
    issuer_id = options[:issuer_id] || meta["apple_issuer_id"]
    key_filepath = resolve_path(options[:key_filepath] || meta["apple_key_path"])

    UI.user_error!("IPA file not found") unless ipa_path && File.exist?(ipa_path)
    UI.user_error!("Missing apple_key_id in options or release_metadata.json") unless key_id && !key_id.empty?
    UI.user_error!("Missing apple_issuer_id in options or release_metadata.json") unless issuer_id && !issuer_id.empty?
    UI.user_error!("Key file not found at #{key_filepath}") unless key_filepath && File.exist?(key_filepath)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_filepath
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
