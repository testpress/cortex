default_platform(:android)

platform :android do
  desc "Deploy Android App Bundle to Google Play Store"
  lane :deploy do |options|
    package_name = options[:package_name]
    aab_path = options[:aab] || "app/build/app/outputs/bundle/release/app-release.aab"
    json_key = options[:json_key] || "app/android/play_console_key.json"
    track = options[:track] || "production"

    UI.user_error!("Missing :package_name option") unless package_name && !package_name.empty?
    UI.user_error!("AAB file not found at #{aab_path}") unless File.exist?(aab_path)
    UI.user_error!("Play Console key file not found at #{json_key}") unless File.exist?(json_key)

    upload_to_play_store(
      package_name: package_name,
      track: track,
      aab: aab_path,
      json_key: json_key,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: "completed"
    )
  end
end

platform :ios do
  desc "Fetch provisioning profile using App Store Connect API Key"
  lane :get_profile do |options|
    bundle_id = options[:bundle_id]
    key_id = options[:key_id]
    issuer_id = options[:issuer_id]
    key_filepath = options[:key_filepath]

    UI.user_error!("Missing :bundle_id") unless bundle_id && !bundle_id.empty?
    UI.user_error!("Missing :key_id") unless key_id && !key_id.empty?
    UI.user_error!("Missing :issuer_id") unless issuer_id && !issuer_id.empty?
    UI.user_error!("Key file not found at #{key_filepath}") unless key_filepath && File.exist?(key_filepath)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: File.expand_path(key_filepath)
    )

    get_provisioning_profile(
      app_identifier: bundle_id,
      api_key: api_key,
      force: true
    )
  end

  desc "Deploy iOS IPA to TestFlight"
  lane :deploy do |options|
    ipa_path = options[:ipa] || Dir["app/build/ios/ipa/*.ipa"].first
    key_id = options[:key_id]
    issuer_id = options[:issuer_id]
    key_filepath = options[:key_filepath]

    UI.user_error!("IPA file not found") unless ipa_path && File.exist?(ipa_path)
    UI.user_error!("Missing :key_id") unless key_id && !key_id.empty?
    UI.user_error!("Missing :issuer_id") unless issuer_id && !issuer_id.empty?
    UI.user_error!("Key file not found at #{key_filepath}") unless key_filepath && File.exist?(key_filepath)

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: File.expand_path(key_filepath)
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      notify_external_testers: false
    )
  end
end
